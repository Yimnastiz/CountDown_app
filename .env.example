# Public: safe to expose to the browser. Generate this together with the private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Secret: server-only. Never prefix this variable with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=

# Contact URI required by the VAPID standard (for example, mailto:you@example.com).
VAPID_SUBJECT=mailto:example@example.com

# Public Supabase project values. Safe for the browser; database access is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only scheduler credentials. Never prefix either variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
